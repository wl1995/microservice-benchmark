<launch>
  <arg name="vehicle_model" description="vehicle model name"/>

  <!-- planning module -->

  <arg name="vehicle_info_param_file" default="$(find-pkg-share $(var vehicle_model)_description)/config/vehicle_info.param.yaml"/>

  <!-- parameter path -->
  <arg name="tier4_planning_launch_param_path" default="$(find-pkg-share tier4_planning_launch)/config" description="tier4_planning_launch parameter path"/>

  <!-- pointcloud container -->
  <arg name="use_pointcloud_container" default="true"/>
  <arg name="pointcloud_container_name" default="pointcloud_container"/>

  <!-- from senario_planning.launch.xml -->
  <arg name="common_param_path" default="$(var tier4_planning_launch_param_path)/scenario_planning/common/common.param.yaml"/>
  <arg name="nearest_search_param_path" default="$(var tier4_planning_launch_param_path)/scenario_planning/common/nearest_search.param.yaml"/>


  <arg name="launch_planning1" default="false" description="launch part1"/>
  <arg name="launch_planning2" default="false" description="launch part2"/>
  <arg name="launch_planning3" default="false" description="launch part3"/>
  <arg name="launch_planning4" default="false" description="launch part4"/>
  <arg name="launch_planning5" default="false" description="launch part5"/>

  <!-- Global parameters -->
  <group if="$(var launch_planning3)" scoped="false">
    <include file="$(find-pkg-share global_parameter_loader)/launch/global_params.launch.py">
      <arg name="use_sim_time" value="false"/>
      <arg name="vehicle_model" value="$(var vehicle_model)"/>
    </include>
  </group>

  <group>
    <push-ros-namespace namespace="planning"/>
    <!-- mission planning module -->
    <group if="$(var launch_planning1)">
      <push-ros-namespace namespace="mission_planning"/>
      <include file="$(find-pkg-share tier4_planning_launch)/launch/mission_planning/mission_planning.launch.xml"/>
    </group>

    <!-- scenario planning module -->
    <group>
      <push-ros-namespace namespace="scenario_planning"/>
      <!-- scenario selector -->
      <group if="$(var launch_planning2)">
        <include file="$(find-pkg-share scenario_selector)/launch/scenario_selector.launch.xml">
          <arg name="input_lane_driving_trajectory" value="/planning/scenario_planning/lane_driving/trajectory"/>
          <arg name="input_parking_trajectory" value="/planning/scenario_planning/parking/trajectory"/>
          <arg name="input_lanelet_map" value="/map/vector_map"/>
          <arg name="input_route" value="/planning/mission_planning/route"/>
          <arg name="input_odometry" value="/localization/kinematic_state"/>
          <arg name="output_scenario" value="/planning/scenario_planning/scenario"/>
          <arg name="output_trajectory" value="/planning/scenario_planning/scenario_selector/trajectory"/>
          <arg name="is_parking_completed" value="/planning/scenario_planning/parking/is_completed"/>
        </include>
      </group>

      <!-- velocity planning with max velocity, acceleration, jerk, stop point constraint -->
      <group if="$(var launch_planning3)">
        <arg name="param_path" default="$(var tier4_planning_launch_param_path)/scenario_planning/common/motion_velocity_smoother/motion_velocity_smoother.param.yaml"/>
        <!-- external velocity limit selector -->
        <group>
          <include file="$(find-pkg-share external_velocity_limit_selector)/launch/external_velocity_limit_selector.launch.xml">
            <arg name="common_param_path" value="$(var common_param_path)"/>
            <arg name="param_path" value="$(var param_path)"/>
          </include>
        </group>
        <!-- motion velocity smoother -->
        <group>
          <arg name="smoother_type" default="JerkFiltered" description="options: JerkFiltered, L2, Analytical, Linf(Unstable)"/>
          <set_remap from="~/input/trajectory" to="/planning/scenario_planning/scenario_selector/trajectory"/>
          <set_remap from="~/output/trajectory" to="/planning/scenario_planning/trajectory"/>
          <include file="$(find-pkg-share motion_velocity_smoother)/launch/motion_velocity_smoother.launch.xml">
            <arg name="smoother_type" value="$(var smoother_type)"/>
            <arg name="common_param_path" value="$(var common_param_path)"/>
            <arg name="nearest_search_param_path" value="$(var nearest_search_param_path)"/>
            <arg name="param_path" value="$(var param_path)"/>
            <arg name="smoother_param_path" value="$(var tier4_planning_launch_param_path)/scenario_planning/common/motion_velocity_smoother/$(var smoother_type).param.yaml"/>
          </include>
        </group>
      </group>

      <!-- scenarios-->
      <group if="$(var launch_planning4)">
        <!-- lane driving -->
        <group>
          <include file="$(find-pkg-share tier4_planning_launch)/launch/scenario_planning/lane_driving.launch.xml">
            <arg name="common_param_path" value="$(var common_param_path)"/>
            <arg name="vehicle_info_param_file" value="$(var vehicle_info_param_file)"/>
            <arg name="use_pointcloud_container" value="$(var use_pointcloud_container)"/>
            <arg name="pointcloud_container_name" value="$(var pointcloud_container_name)"/>
            <arg name="tier4_planning_launch_param_path" value="$(var tier4_planning_launch_param_path)"/>
          </include>
        </group>
        <!-- parking -->
        <group>
          <include file="$(find-pkg-share tier4_planning_launch)/launch/scenario_planning/parking.launch.py">
            <arg name="vehicle_info_param_file" value="$(var vehicle_info_param_file)"/>
          </include>
        </group>
      </group>
    </group>
    

    <!-- planning error monitor -->
    <group if="$(var launch_planning5)">
      <push-ros-namespace namespace="planning_diagnostics"/>
      <include file="$(find-pkg-share tier4_planning_launch)/launch/planning_diagnostics/planning_error_monitor.launch.xml"/>
    </group>
  </group>
</launch>
